# Copiar a config.env y ajustar. Contiene un secreto: chmod 600 y propietario root.
#
#   cp config.env.example config.env && chmod 600 config.env

# Token de API de Cloudflare con permisos Zone:Read + DNS:Edit sobre las zonas
# listadas en zones.conf. NO necesita permisos de SSL/SaaS.
# Se crea en: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=pon_aqui_tu_token

# Fuente de IPs bloqueadas. La lista "-any" son las bloqueadas por CUALQUIER
# operador, que es lo que interesa: protege tambien a visitantes de operadores
# distintos al tuyo. Hay listas por operador (blocked-movistar.txt,
# blocked-orange.txt, blocked-vodafone.txt, blocked-digi.txt, blocked-masmovil.txt).
BLOCKLIST_URL=https://hayahora.futbol/estado/blocked-any.txt

# Que hacer si la lista no se puede descargar, no responde 200 o no parsea:
#
#   hold   No tocar nada: cada zona se queda como este. Es el valor por defecto
#          y el mas conservador; si la fuente esta caida largo rato y empieza un
#          bloqueo, no te enteras.
#   probe  Decidir solo con la sonda TCP local contra el par de IPs memorizado.
#          Es la mejor opcion SI la maquina esta en un pais/red afectado, porque
#          entonces puede comprobar por si misma si sus IPs siguen alcanzables.
#          Inutil si el servidor esta fuera de la red donde ocurre el bloqueo.
#   orange Devolver todo a naranja (prioriza tener cache y WAF).
#   grey   Pasar todo a gris (prioriza que la web sea accesible pase lo que pase).
#
# Nota: una lista vacia NO es un error, es el estado normal fuera de las ventanas
# de bloqueo. Esta politica solo entra cuando la descarga falla de verdad.
BLOCKLIST_ERROR_POLICY=hold

# Ciclos seguidos sin bloqueo antes de reactivar la nube. Con el timer cada
# minuto, 2 = dos minutos de margen para no rebotar en mitad de una ventana.
CLEAR_CONFIRMATIONS=2

# Resolver publico contra el que se consultan las IPs de cada zona. No se usa el
# del sistema porque puede tener cacheada una respuesta distinta.
RESOLVER=1.1.1.1

# Sonda TCP propia antes de volver a naranja. Dejar en 1: si la maquina esta en
# una red afectada, confirma de primera mano que las IPs vuelven a ser
# alcanzables. Es ademas la red de seguridad si la fuente de la lista falla.
PROBE_ENABLED=1
PROBE_TIMEOUT=4

# TTL que se pone al registro mientras esta en gris (en naranja lo fija Cloudflare).
GREY_TTL=60

HTTP_TIMEOUT=15
